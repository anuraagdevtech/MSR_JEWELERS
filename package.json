{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng.mjs serve",
    "build": "node scripts/ng.mjs build",
    "watch": "node scripts/ng.mjs build --watch --configuration development",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:supabase": "node scripts/ng.mjs serve --local-supabase --port 4311",
    "supabase:setup": "node scripts/local-supabase.mjs setup",
    "supabase:seed": "node scripts/local-supabase.mjs seed",
    "supabase:stop": "supabase stop",
    "test:supabase": "node scripts/test-supabase.mjs",
    "supabase:sample-data": "node --import tsx scripts/seed-local-data.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@supabase/supabase-js": "^2.116.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@electric-sql/pglite": "^0.5.10",
    "postgres": "^3.4.9",
    "prettier": "^3.8.1",
    "supabase": "^2.121.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
