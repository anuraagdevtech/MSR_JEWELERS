# Copy to .env (git-ignored) to run against your Supabase project locally.
# Supabase dashboard → Project Settings → API: "Project URL" and the "anon" / "publishable" key.
# The anon key is safe in the browser; data is protected by the database's access rules.
# Never put the service_role / secret key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
